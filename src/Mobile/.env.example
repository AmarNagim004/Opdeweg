# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app —
# never put server secrets (JWT_SECRET, LIVEKIT_API_SECRET, ...) here.

# Backend base URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:5080.
# Release builds refuse anything that is not https://.
EXPO_PUBLIC_API_URL=http://localhost:5080

# "development" builds a separately installable "Opdeweg Dev" app that allows cleartext HTTP.
APP_VARIANT=development
