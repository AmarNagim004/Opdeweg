# ---------------------------------------------------------------------------
# Opdeweg backend configuration. Copy to `.env` (git-ignored) and fill in.
# The API reads these variables directly; in Development it also loads `.env`.
# NEVER commit real values. Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# PostgreSQL + PostGIS (Npgsql connection string)
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=opdeweg;Username=opdeweg;Password=change-me

# Redis (StackExchange.Redis configuration string)
REDIS_CONNECTION_STRING=localhost:6379

# HMAC key for access tokens: at least 32 bytes of randomness.
JWT_SECRET=

# LiveKit SFU
#   LIVEKIT_URL      – what the mobile app connects to (ws:// in dev, wss:// in production).
#                      On a physical phone use your computer's LAN IP, e.g. ws://192.168.1.20:7880
#   LIVEKIT_API_URL  – optional: how the API reaches LiveKit's server API (defaults to LIVEKIT_URL as http/https)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# ---- docker-compose only ----------------------------------------------------
POSTGRES_USER=opdeweg
POSTGRES_PASSWORD=change-me
# IP LiveKit advertises for media (your LAN IP when testing on a phone).
LIVEKIT_NODE_IP=127.0.0.1
# Where LiveKit posts webhooks (the API running on your host by default).
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:5080/api/v1/livekit/webhook
