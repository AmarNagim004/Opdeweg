<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1515: types in app projects are internal-by-default noise; CA1848/CA1873 handled via LoggerMessage where it matters. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1873;CA2007;CA1062;CA1716;CA1711;CA1032;CA1064;CA1724;CA1034;CA1812;CA5394;CA1308;CA1031;CA2000;CA1056;CA1054;CA1819;CA1002;CA2227;CA1805</NoWarn>
  </PropertyGroup>
</Project>
